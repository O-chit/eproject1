{
  "name": "craftroots",
  "version": "1.0.0",
  "description": "CraftRoots - Traditional Heritage Crafts Discovery Portal (eProject Aptech)",
  "private": true,
  "scripts": {
    "server:dev": "nodemon server/src/server.js",
    "server:start": "node server/src/server.js",
    "db:test": "node server/src/test-db.js",
    "db:init": "psql -U postgres -d craftroots -f db/schema.sql",
    "db:seed": "psql -U postgres -d craftroots -f db/seed.sql",
    "api:test": "node server/src/test-api.js"
  },
  "keywords": [
    "craftroots",
    "heritage-crafts",
    "express",
    "postgresql"
  ],
  "author": "CraftRoots Team",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
