{
  "name": "craftroots-server",
  "version": "1.0.0",
  "description": "CraftRoots REST API Backend - Node.js, Express, PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:test": "node src/test-db.js",
    "db:init": "psql -U postgres -d craftroots -f db/schema.sql",
    "db:seed": "psql -U postgres -d craftroots -f db/seed.sql"
  },
  "keywords": [
    "craftroots",
    "postgresql",
    "express",
    "nodejs",
    "heritage-crafts"
  ],
  "author": "CraftRoots Team",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
