PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=craftroots
DB_USER=postgres
DB_PASSWORD=your_db_password

# Database Connection URI (Full Connection String)
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/craftroots

# JWT Authentication
JWT_SECRET=your_long_and_secure_jwt_secret_here
JWT_EXPIRES_IN=1d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
